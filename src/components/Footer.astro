---
import Mark from "./Mark.astro"
import { brand, products, groups } from "../data/brand"

const year = new Date().getFullYear()
const columns = [
  ...(["business", "consumer"] as const).map((g) => ({
    title: groups[g].title,
    links: products.filter((p) => p.group === g).map((p) => ({ href: p.href, label: p.name })),
  })),
  {
    title: "For dental offices",
    links: [
      { href: "/tools/", label: "Free printable logs" },
      { href: "/guides/", label: "Guides" },
      { href: "/states/", label: "Rules by state" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/#company", label: "About" },
      { href: "/#contact", label: "Contact" },
    ],
  },
]
---
<footer data-site class="mt-section border-t border-gray-a6 bg-gray-2">
  <div class="mx-auto max-w-page px-gutter py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,minmax(0,1fr))]">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center gap-2.5 text-gray-12 no-underline">
          <Mark class="size-7" />
          <span class="font-semibold">{brand.legalName}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-gray-11">Software for businesses and for everyday life, made in Charlottetown, Prince Edward Island.</p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h2 class="text-sm font-semibold text-gray-12">{c.title}</h2>
          <ul class="mt-3 grid gap-1 text-sm">
            {c.links.map((l) => (
              <li><a href={l.href} class="inline-flex min-h-8 items-center text-gray-11 no-underline hover:text-gray-12 hover:underline">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-gray-a6 pt-6 text-sm text-gray-11">
      <p>© {year} {brand.legalName}</p>
      <p>{brand.address.street}, {brand.address.city}, {brand.address.region} {brand.address.postal}, Canada</p>
    </div>
  </div>
</footer>
