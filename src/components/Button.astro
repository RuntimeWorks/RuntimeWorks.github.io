---
// A link styled as a button. 44 px tall (Apple HIG primary targets); press scale 0.97 (Emil Kowalski;
// SPEC.md §9); Carbon's fast duration and productive curve.
interface Props { href: string; variant?: "primary" | "secondary" | "on-accent"; class?: string }
const { href, variant = "primary", class: cls } = Astro.props
const look = {
  primary: "bg-accent-9 text-accent-contrast hover:bg-accent-10",
  secondary: "border border-gray-8 bg-gray-1 text-gray-12 hover:bg-gray-3",
  "on-accent": "bg-accent-contrast text-accent-9 hover:opacity-90",
}[variant]
---
<a href={href} class:list={["inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 text-base font-semibold no-underline transition duration-fast ease-productive motion-safe:active:scale-[0.97]", look, cls]}><slot /></a>
