---
// A link styled as a button, in the old site's four kinds (git 5b0fcac .btn, .btn-dark, .btn-light, .btn-ghost-l):
// primary navy, secondary outlined in ink, and on a navy band a sand button and an outlined one. 46 px tall, 10 px
// corners, bold text. Press scale 0.97 under motion-safe only (Emil Kowalski; SPEC.md §9; Hallmark gate 27).
interface Props { href: string; variant?: "primary" | "secondary" | "light" | "ghost"; class?: string }
const { href, variant = "primary", class: cls } = Astro.props
const look = {
  primary: "border-accent-9 bg-accent-9 text-accent-contrast hover:border-accent-10 hover:bg-accent-10",
  secondary: "border-gray-12 text-gray-12 hover:bg-gray-a3",
  // On the band the colours stay the theme's own in both light and dark mode.
  light: "border-on-harbour bg-on-harbour text-ink hover:border-white hover:bg-white",
  ghost: "border-harbour-ghost text-on-harbour hover:border-on-harbour",
}[variant]
---
<a href={href} class:list={["inline-flex min-h-[46px] items-center justify-center gap-2 rounded-control border-[1.5px] px-5 text-sm font-bold no-underline transition duration-fast ease-productive motion-safe:active:scale-[0.97]", look, cls]}><slot /></a>
