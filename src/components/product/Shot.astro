---
// A real product screen with its caption. Screens only: no drawn mock-ups (Hallmark: no fake chrome). On paper or
// sand it sits on a soft shadow (git 5b0fcac .card .vis img); on the navy band it sits in the old site's framed panel
// (.screen .frame: a 10 px harbour-2 border and a deep shadow). With href, the caption is the link to what it shows.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
interface Props { src: ImageMetadata; alt: string; caption?: string; href?: string; sizes?: string; eager?: boolean; band?: boolean; class?: string }
const { src, alt, caption, href, sizes = "(min-width: 1024px) 600px, 100vw", eager = false, band = false, class: cls } = Astro.props
---
<figure class:list={["m-0", cls]}>
  <div class:list={band ? "overflow-hidden rounded-card border-[10px] border-harbour-2 bg-harbour-2 shadow-frame" : "overflow-hidden rounded-[6px] shadow-shot"}>
    <Image src={src} alt={alt} widths={[400, 600, 900, 1200].filter((w) => w <= src.width * 1)} sizes={sizes} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} class="block w-full" />
  </div>
  {caption && <figcaption class:list={["mt-3 text-sm", band ? "text-on-harbour-2" : "text-gray-11"]}>{href ? <a href={href} class="font-medium text-accent-11 underline underline-offset-4">{caption}</a> : caption}</figcaption>}
</figure>
