---
// A real product screen with its caption. Screens only: no drawn mock-ups (Hallmark: no fake chrome). With href,
// the caption is the link to what the picture shows.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
interface Props { src: ImageMetadata; alt: string; caption?: string; href?: string; sizes?: string; eager?: boolean; class?: string }
const { src, alt, caption, href, sizes = "(min-width: 1024px) 600px, 100vw", eager = false, class: cls } = Astro.props
---
<figure class:list={["m-0", cls]}>
  <Image src={src} alt={alt} widths={[400, 600, 900, 1200].filter((w) => w <= src.width * 1)} sizes={sizes} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} class="w-full rounded-xl outline -outline-offset-1 outline-gray-a6" />
  {caption && <figcaption class="mt-3 text-sm text-gray-11">{href ? <a href={href} class="font-medium text-accent-11 underline underline-offset-4">{caption}</a> : caption}</figcaption>}
</figure>
