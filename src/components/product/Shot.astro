---
// A real product screen with its caption. Screens only: no drawn mock-ups (Hallmark: no fake chrome).
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
interface Props { src: ImageMetadata; alt: string; caption?: string; sizes?: string; eager?: boolean; class?: string }
const { src, alt, caption, sizes = "(min-width: 1024px) 600px, 100vw", eager = false, class: cls } = Astro.props
---
<figure class:list={["m-0", cls]}>
  <Image src={src} alt={alt} widths={[400, 600, 900, 1200].filter((w) => w <= src.width * 1)} sizes={sizes} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} class="w-full rounded-xl border border-gray-a6 shadow-lg" />
  {caption && <figcaption class="mt-3 text-sm text-gray-11">{caption}</figcaption>}
</figure>
