---
// Questions and answers as native <details> (WAI-ARIA disclosure; works without script). FAQPage data for search.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props
const ld = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })) }
---
<div class="grid max-w-measure gap-2">
  {items.map((i) => (
    <details class="rise group card px-5">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-3 text-lg font-medium text-gray-12 [&::-webkit-details-marker]:hidden">
        {i.q}<span class="text-2xl leading-none text-gray-10 transition-transform duration-moderate ease-productive group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="pb-5 text-gray-11">{i.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
