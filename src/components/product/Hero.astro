---
// A page's opening, in PurchaseRow's shape: the name leads at display size (taste-skill inspect "focal-point"), the
// promise and what it does follow as paragraphs (a statement belongs in a <p>), then what to do, then the facts that
// used to sit above the heading as an eyebrow (impeccable and taste-skill: no eyebrows). The product's real screen
// goes full width below.
import Status from "../Status.astro"
import type { Status as S } from "../../data/brand"
interface Props { name: string; nameSuffix?: string; promise: string; lead?: string; status?: S; facts?: string[] }
const { name, nameSuffix, promise, lead, status, facts = [] } = Astro.props
---
<section aria-labelledby="h1">
  <div class="mx-auto max-w-page px-gutter pt-section pb-12">
    <h1 id="h1" class="rise text-display font-semibold text-gray-12">{name}{nameSuffix && <span class="sr-only">{nameSuffix}</span>}</h1>
    <div class="rise mt-10 grid items-end gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <div>
        <p class="max-w-measure text-lg font-medium text-gray-12">{promise}</p>
        {lead && <p class="mt-3 max-w-measure text-gray-11">{lead}</p>}
        <div class="mt-8 flex flex-wrap gap-3"><slot name="actions" /></div>
      </div>
      {(status || facts.length > 0) && (
        <div class="grid content-end gap-3 lg:justify-self-end">
          {status && <Status status={status} />}
          {facts.length > 0 && <ul class="grid gap-1.5 text-sm text-gray-11">{facts.map((f) => <li>{f}</li>)}</ul>}
        </div>
      )}
    </div>
    {Astro.slots.has("visual") && <div class="mt-14"><slot name="visual" /></div>}
  </div>
</section>
