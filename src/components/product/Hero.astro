---
// A page's opening as the old site's navy band (git 5b0fcac .hero): the heading in Archivo, the promise and
// what it does, the actions, then the stage and the facts; the product's real screen sits in a framed panel beside
// it on wide screens and below it on phones. The heading is the product's name, or the page's own words in a "title"
// slot (the home page). Words never sit above the heading (impeccable and taste-skill: no eyebrows).
import Status from "../Status.astro"
import type { Status as S } from "../../data/brand"
// "wide" sets a long heading across the whole band above the two columns, so it stays within two lines (SPEC.md §8).
interface Props { name: string; nameSuffix?: string; promise: string; lead?: string; status?: S; facts?: string[]; wide?: boolean }
const { name, nameSuffix, promise, lead, status, facts = [], wide = false } = Astro.props
const visual = Astro.slots.has("visual")
---
<section aria-labelledby="h1" class="bg-harbour text-on-harbour">
  <div class="mx-auto max-w-page px-gutter pt-section pb-section">
    {wide && (
      <h1 id="h1" class="rise heading mb-10 text-hero text-on-harbour">{Astro.slots.has("title") ? <slot name="title" /> : name}{nameSuffix && <span class="sr-only">{nameSuffix}</span>}</h1>
    )}
    <div class:list={["grid items-center gap-x-16 gap-y-12", visual && "lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"]}>
      <div class="rise">
        {!wide && <h1 id="h1" class="heading text-hero text-on-harbour">{Astro.slots.has("title") ? <slot name="title" /> : name}{nameSuffix && <span class="sr-only">{nameSuffix}</span>}</h1>}
        <p class:list={["max-w-measure text-lg text-on-harbour", !wide && "mt-6"]}>{promise}</p>
        {lead && <p class="mt-3 max-w-measure text-on-harbour-2">{lead}</p>}
        <div class="mt-8 flex flex-wrap gap-3"><slot name="actions" /></div>
        {(status || facts.length > 0) && (
          <ul class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-on-harbour-2">
            {status && <li><Status status={status} onBand /></li>}
            {facts.map((f) => <li>{f}</li>)}
          </ul>
        )}
      </div>
      {visual && <div class="rise"><slot name="visual" /></div>}
    </div>
  </div>
</section>
