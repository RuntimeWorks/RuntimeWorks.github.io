---
// Site header. Three links; under 640 px they move into a native <details> disclosure (WAI-ARIA APG disclosure
// pattern, no script needed). The current page's link carries aria-current (GOV.UK service navigation).
import Mark from "./Mark.astro"
import { brand } from "../data/brand"

const links = [
  { href: "/#products", label: "Products" },
  { href: "/#company", label: "Company" },
  { href: "/#contact", label: "Contact" },
]
---
<header data-site class="sticky top-0 z-30 bg-background">
  <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-gutter">
    <a href="/" class="mr-auto flex min-h-11 items-center gap-2.5 text-gray-12 no-underline" aria-label={`${brand.name}, home`}>
      <Mark class="size-8" />
      <span class="text-lg font-semibold tracking-tight">{brand.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="hidden items-center gap-1 text-sm font-medium sm:flex">
        {links.map((l) => (
          <li><a href={l.href} class="inline-flex min-h-11 items-center rounded-md px-3 text-gray-11 no-underline transition-colors duration-fast ease-productive hover:bg-gray-a3 hover:text-gray-12">{l.label}</a></li>
        ))}
      </ul>
    <details class="group relative sm:hidden" data-menu>
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-md border border-gray-a6 px-4 text-sm font-medium text-gray-12 [&::-webkit-details-marker]:hidden">Menu</summary>
      <div class="absolute right-0 top-full mt-2 w-56 rounded-lg border border-gray-a6 bg-gray-1 p-2 group-open:shadow-lg">{/* taste-skill-ignore: the open menu is a real overlay; it gets its shadow only while open */}
        <ul class="grid text-base">
          {links.map((l) => (
            <li><a href={l.href} class="flex min-h-11 items-center rounded-md px-3 text-gray-12 no-underline hover:bg-gray-a3">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </details>
    </nav>
  </div>
</header>
<script>
  // Close the phone menu after a link is followed or Escape is pressed (APG disclosure keyboard contract).
  const menu = document.querySelector<HTMLDetailsElement>("details[data-menu]")
  menu?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false })
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.open) { menu.open = false; menu.querySelector("summary")?.focus() }
  })
</script>
