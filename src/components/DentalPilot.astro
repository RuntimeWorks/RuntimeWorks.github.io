---
// The Dental Logbook pilot box at the end of every library page. Each page keeps its own words from the old site.
import Button from "./Button.astro"
import Status from "./Status.astro"
import { brand } from "../data/brand"
interface Props { heading?: string; text?: string; link?: string }
const heading = Astro.props.heading || "Want this done for you?"
// The button says one short thing on one line (Hallmark gate 49). Where an old page's link carried a longer sentence,
// that sentence stays on the page as the box's text.
const button = "Join the free pilot"
const link = Astro.props.link && Astro.props.link !== button ? Astro.props.link : undefined
const lines = [Astro.props.text, link].filter((x): x is string => Boolean(x))
const href = `mailto:${brand.email}?subject=${encodeURIComponent("Dental Logbook pilot")}`
---
<aside data-page-foot aria-labelledby="pilot-h" class="rise mt-section rounded-2xl bg-gray-a3 p-6 sm:p-10">
  <h2 id="pilot-h" class="text-2xl font-semibold tracking-tight text-gray-12">{heading}</h2>
  {(lines.length ? lines : ["Dental Logbook is in development. Join the free pilot."]).map((t) => <p class="mt-3 max-w-measure text-gray-11">{t}</p>)}
  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-11"><Status status="In development" />Dental Logbook</div>
  <div class="mt-6"><Button href={href}>{button}</Button></div>
</aside>
