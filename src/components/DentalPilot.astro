---
// The Dental Logbook pilot box at the end of every library page. Each page keeps its own words from the old site.
import Button from "./Button.astro"
import { brand } from "../data/brand"
interface Props { heading?: string; text?: string; link?: string }
const heading = Astro.props.heading || "Want this done for you?"
const text = Astro.props.text || "Dental Logbook is in development. Join the free pilot."
const link = Astro.props.link || "Join the free pilot"
const href = `mailto:${brand.email}?subject=${encodeURIComponent("Dental Logbook pilot")}`
---
<aside data-page-foot aria-labelledby="pilot-h" class="mt-section rounded-2xl border border-gray-a6 bg-gray-2 p-6 sm:p-10">
  <p class="text-sm font-medium text-accent-11">Dental Logbook · in development</p>
  <h2 id="pilot-h" class="mt-2 text-2xl font-semibold tracking-tight text-gray-12">{heading}</h2>
  <p class="mt-3 max-w-measure text-gray-11">{text}</p>
  <div class="mt-6"><Button href={href}>{link}</Button></div>
</aside>
