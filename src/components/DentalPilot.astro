---
// The Dental Logbook pilot box at the end of every library page, on the theme's navy (as the old contact card). Each page keeps its own words from the old site.
import Button from "./Button.astro"
import Status from "./Status.astro"
import { brand } from "../data/brand"
interface Props { heading?: string; text?: string; link?: string }
const heading = Astro.props.heading || "Want this done for you?"
// The button says one short thing on one line (Hallmark gate 49). Where an old page's link carried a longer sentence,
// that sentence stays on the page as the box's text.
const button = "Join the free pilot"
const link = Astro.props.link && Astro.props.link !== button ? Astro.props.link : undefined
const lines = [Astro.props.text, link].filter((x): x is string => Boolean(x))
const href = `mailto:${brand.email}?subject=${encodeURIComponent("Dental Logbook pilot")}`
---
<aside data-page-foot aria-labelledby="pilot-h" class="rise mt-section rounded-card bg-harbour p-6 text-on-harbour sm:p-10">
  <h2 id="pilot-h" class:list={["heading", heading.length > 60 ? "text-xl" : "text-2xl"]}>{heading}</h2>
  {(lines.length ? lines : ["Dental Logbook is in development. Join the free pilot."]).map((t) => <p class="mt-3 max-w-measure text-on-harbour-2">{t}</p>)}
  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-on-harbour-2"><Status status="In development" onBand />Dental Logbook</div>
  <div class="mt-6"><Button href={href} variant="light">{button}</Button></div>
</aside>
