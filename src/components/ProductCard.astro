---
// One product: picture, status, name, what it does, who it is for, one link.
// The whole card is clickable through its heading link stretched over the card (Heydon Pickering, Inclusive
// Components, "Cards"), so a screen reader hears one link with the product's name, not a wall of text.
import { Image } from "astro:assets"
import { ArrowRight, ArrowUpRight } from "@lucide/astro"
import type { Product } from "../data/brand"
import { productImages } from "../data/product-images"
import Status from "./Status.astro"

interface Props { product: Product; wide?: boolean }
const { product: p, wide = false } = Astro.props
const img = productImages[p.id]
const Arrow = p.external ? ArrowUpRight : ArrowRight
---
<article class:list={["rise group relative flex flex-col overflow-hidden rounded-xl bg-gray-a3 transition-transform duration-moderate ease-productive motion-safe:hover:-translate-y-0.5", wide && "md:grid md:grid-cols-[minmax(0,1fr)_16rem]"]}>
  {img && (
    <div class:list={["bg-gray-3", wide && "md:order-2"]}>
      {img.kind === "screen" ? (
        <Image src={img.src} alt={img.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[16/10] w-full object-cover object-top" loading="lazy" />
      ) : (
        <div class:list={["grid h-full place-items-center", wide ? "aspect-[16/10] md:aspect-auto md:min-h-56" : "aspect-[16/10]"]}>
          <Image src={img.src} alt={img.alt} widths={[128, 256]} sizes="128px" class="size-28 rounded-[22%]" loading="lazy" />
        </div>
      )}
    </div>
  )}
  <div class="flex flex-1 flex-col gap-3 p-6 sm:p-8">
    <Status status={p.status} />
    <h4 class="text-xl font-semibold text-gray-12">
      <a href={p.href} class="no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-focus-within:after:rounded-xl group-focus-within:after:outline-2 group-focus-within:after:outline-accent-9">{p.name}{p.external && <span class="sr-only">, on {new URL(p.href).host}</span>}</a>
    </h4>
    <p class="text-base text-gray-12">{p.summary}</p>
    <p class="text-sm text-gray-11">For {p.audience.charAt(0).toLowerCase() + p.audience.slice(1)}.</p>
    <p class="mt-auto flex items-center gap-1.5 pt-2 text-sm font-semibold text-accent-11" aria-hidden="true">
      {p.cta}<Arrow class="size-4 transition-transform duration-moderate ease-productive group-hover:translate-x-0.5" />
    </p>
  </div>
</article>
