---
// One product as a card in a two-column grid (founder, 2026-11-07: smaller than the old full-width rows, with the
// product's picture large and formal wording): the product's cover across the top, edge to edge (its own front page,
// src/data/product-images.ts) over a 1 px line, the edge where a white page meets the white card (defended against
// taste-skill "hairline": without it Sheets Converter's page runs into the text), then the name, what kind of
// product it is, one formal sentence, and a footer with the stage and where the card leads. The whole card is
// clickable through its heading link stretched over it (Heydon Pickering, Inclusive Components, "Cards"), so a screen
// reader hears one link with the product's name, not a wall of text.
import { Image } from "astro:assets"
import { ArrowRight, ArrowUpRight } from "@lucide/astro"
import type { Product } from "../data/brand"
import { productImages } from "../data/product-images"
import Status from "./Status.astro"

interface Props { product: Product }
const { product: p } = Astro.props
const img = productImages[p.id]
const Arrow = p.external ? ArrowUpRight : ArrowRight
---
<article class="card rise group relative flex flex-col overflow-hidden transition-shadow duration-moderate ease-productive hover:shadow-card-hover">
  {img && (
    <div class="aspect-[16/10] overflow-hidden border-b border-line bg-sand">
      <Image src={img.src} alt={img.alt} widths={[480, 640, 960, 1280]} sizes="(min-width: 1024px) 560px, 100vw" class="h-full w-full object-cover object-top" loading="lazy" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <h4 class="heading text-h4 text-gray-12">
      <a href={p.href} class="no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-focus-within:after:rounded-card group-focus-within:after:outline-2 group-focus-within:after:outline-accent-9">{p.name}{p.external && <span class="sr-only">, on {new URL(p.href).host}</span>}</a>
    </h4>
    <p class="label mt-1 text-gray-11">{p.category}</p>
    <p class="mt-4 text-gray-11">{p.summary}</p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6">
      <Status status={p.status} />
      <p class="flex items-center gap-1.5 text-sm font-bold text-gray-12" aria-hidden="true">
        {p.cta}<Arrow class="size-4 transition-transform duration-moderate ease-productive motion-safe:group-hover:translate-x-0.5" />
      </p>
    </div>
  </div>
</article>
