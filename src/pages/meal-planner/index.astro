---
// The meal planner (no name yet; com.boldsand.nutrition). Words from the app as it stands on 2026-11-07
// (projects/nutrition-app/HANDOFF.md, START-HERE.md §4.2): a week planned to a budget, diet and allergies, one grocery
// list, cook mode, nutrients from USDA data. The waitlist wording is the live waitlist page's (2026-10-29).
import Base from "../../layouts/Base.astro"
import Hero from "../../components/product/Hero.astro"
import Section from "../../components/product/Section.astro"
import Checklist from "../../components/product/Checklist.astro"
import Faq from "../../components/product/Faq.astro"
import Button from "../../components/Button.astro"
import { Image } from "astro:assets"
import { brand } from "../../data/brand"
import icon from "../../assets/products/meal-planner-icon.png"

const join = `mailto:${brand.email}?subject=${encodeURIComponent("Meal planner waitlist")}&body=${encodeURIComponent("Please email me once when the Boldsand meal planner launches.")}`
const faq = [
  { q: "When can I use it?", a: "It is being built for iPhone and Android. Join the waitlist and we’ll send one email when it launches." },
  { q: "Where do the numbers come from?", a: "Nutrient values come from USDA FoodData Central, the US Department of Agriculture’s public nutrient database, and the week is checked against the Dietary Guidelines for Americans, 2025–2030." },
  { q: "What will it cost?", a: "Pricing will be shown in the app before you subscribe." },
  { q: "Is it medical advice?", a: "No. It shows your intake compared with reference values, as general wellness information. For a medical condition, pregnancy or breastfeeding, check with a doctor or a registered dietitian." },
]
---
<Base title="Meal planner: a week of meals to your budget · Boldsand" description="A meal planner from Boldsand that plans the week around your budget, diet and allergies, with one grocery list. Coming soon to iPhone and Android.">
  <Hero name="Meal planner" promise="A week of meals, planned to your budget." lead="Tell it your budget, how you eat and what you can’t eat. It plans the week and writes one grocery list." status="In development" facts={["An app for iPhone and Android"]}>
    <Fragment slot="actions">
      <Button href={join} variant="light">Join the waitlist</Button>
    </Fragment>
    <div slot="visual" class="grid h-72 place-items-center rounded-card bg-harbour-2 shadow-frame">
      <Image src={icon} alt="The meal planner’s app icon: a white bowl with two leaves on green." widths={[160, 320]} sizes="160px" loading="eager" class="size-40 rounded-[22%]" />
    </div>
  </Hero>

  <Section id="what" title="What it does.">
    <div class="grid gap-10 lg:grid-cols-2">
      <Checklist items={[
        { title: "Your week, planned", text: "Meals that fit your budget, your diet and every allergy you choose." },
        { title: "One grocery list", text: "Only what the week needs. It asks which cupboard foods you already have." },
      ]} />
      <Checklist items={[
        { title: "Cook one step at a time", text: "Each step on its own screen, with timers named for what they time." },
        { title: "Numbers you can check", text: "Calories, protein, carbs and fat for every meal, from USDA food data." },
      ]} />
    </div>
  </Section>

  <Section id="faq" title="Questions" tone="tint">
    <Faq items={faq} />
  </Section>

  <section id="join" aria-labelledby="join-h" class="mx-auto mt-section max-w-page px-gutter">
    <div class="rounded-card bg-harbour p-8 text-on-harbour sm:p-12">
      <h2 id="join-h" class="heading text-h2">Be first to try it</h2>
      <p class="mt-3 max-w-measure">Send us an email and we’ll write back once, on launch day.</p>
      <div class="mt-8"><Button href={join} variant="light">Join the waitlist</Button></div>
      <p class="mt-6 max-w-measure text-sm">Or write to {brand.email}. By emailing us you ask to hear when the app launches. We use your address only for that, and you can reply “stop” at any time to be removed.</p>
    </div>
  </section>
</Base>
