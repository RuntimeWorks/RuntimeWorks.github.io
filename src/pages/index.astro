---
// Home, in the old site's shape and theme (git 5b0fcac, the founder's choice on 2026-11-07): a navy band with the
// headline and a real product screen, "Choose a product." with one lane per audience (1Password's business /
// personal split, read on Mobbin 2026-11-07), the commitments on sand, then the company beside the contact card.
import Base from "../layouts/Base.astro"
import ProductCard from "../components/ProductCard.astro"
import Hero from "../components/product/Hero.astro"
import Button from "../components/Button.astro"
import Section from "../components/product/Section.astro"
import Shot from "../components/product/Shot.astro"
import { brand, products, groups } from "../data/brand"
import appToday from "../assets/products/purchaserow-app-today.png"

const business = products.filter((p) => p.group === "business")
const consumer = products.filter((p) => p.group === "consumer")
const words = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
const count = (n: number, one: string, many: string) => `${words[n] ?? n} ${n === 1 ? one : many}`
const Count = (n: number, one: string, many: string) => count(n, one, many).replace(/^./, (c) => c.toUpperCase())
const lanes = [
  { group: "business" as const, note: "Software for small businesses.", items: business },
  { group: "consumer" as const, note: "Apps for iPhone and Android.", items: consumer },
]

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${brand.url}/#organization`,
  name: brand.legalName,
  legalName: brand.legalName,
  url: `${brand.url}/`,
  logo: `${brand.url}/favicon.svg`,
  email: brand.email,
  telephone: brand.phone.tel,
  foundingDate: brand.incorporated.iso,
  address: { "@type": "PostalAddress", streetAddress: brand.address.street, addressLocality: brand.address.city, addressRegion: brand.address.region, postalCode: brand.address.postal, addressCountry: brand.address.country },
  makesOffer: products.map((p) => ({
    "@type": "Offer",
    itemOffered: { "@type": "SoftwareApplication", name: p.name, url: new URL(p.href, brand.url).href, applicationCategory: p.group === "business" ? "BusinessApplication" : "LifestyleApplication", description: p.summary },
  })),
}

const commitments = [
  { title: "One product, one job", text: "Each product solves one problem for one kind of user." },
  { title: "You reach the people who build it", text: "Every message and call is answered by the team that makes the product." },
  { title: "Your data stays yours", text: "We collect only what a product needs, and every product has its own privacy policy." },
]
---
<Base
  title={`${brand.legalName}: software for businesses and everyday life`}
  description={`${brand.legalName} makes software for small businesses and apps for people: Sheets Converter, PurchaseRow, the Food Safety and Dental Logbooks, and a meal planner. Charlottetown, Prince Edward Island.`}
  jsonLd={jsonLd}
>
  <Hero wide name={brand.name} promise={`${brand.legalName} makes ${count(business.length, "product", "products")} for businesses and ${count(consumer.length, "app", "apps")} for people, from Charlottetown, Prince Edward Island.`} facts={["Built and supported in Charlottetown", `Incorporated ${brand.incorporated.display}`]}>
    <Fragment slot="title"><span class="text-on-harbour-2">Focused</span> software for businesses and everyday life.</Fragment>
    <Fragment slot="actions">
      <Button href="#products" variant="light">See the products</Button>
      <Button href="#contact" variant="ghost">Contact us</Button>
    </Fragment>
    <Shot slot="visual" band eager src={appToday} alt="The PurchaseRow app’s Today screen with sample data: 3 orders to answer, $812.00 owed, $45.00 in open deductions, the next steps, ship windows for three retailers, and an order’s document trail from the 850 order to the 820 payment." caption="PurchaseRow’s Today screen, with sample data." />
  </Hero>

  <section id="products" aria-labelledby="h-products" class="mx-auto max-w-page px-gutter py-section">
    <div class="grid gap-x-16 gap-y-4 lg:grid-cols-2 lg:items-end">
      <h2 id="h-products" class="rise heading text-h2 text-gray-12">Choose a product.</h2>
      <p class="rise max-w-measure text-lg text-gray-11">{Count(business.length, "product", "products")} for businesses and {count(consumer.length, "app", "apps")} for people.</p>
    </div>
    <div class="mt-12 grid gap-16">
      {lanes.map((lane) => (
        <section aria-labelledby={`h-${lane.group}`} class="grid gap-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-10">
          <div>
            <h3 id={`h-${lane.group}`} class="heading text-xl text-gray-12">{groups[lane.group].title}</h3>
            <p class="mt-1 text-sm text-gray-11">{lane.note}</p>
          </div>
          <div class="grid gap-6">
            {lane.items.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      ))}
    </div>
  </section>

  <Section id="how" title="Small company. Clear commitments." intro="Three rules apply to every product we make, for a business or for a person." tone="tint">
    <ul class="grid gap-6 lg:grid-cols-3">
      {commitments.map((c) => (
        <li class="rise card p-6 sm:p-8">
          <h3 class="heading text-xl text-gray-12">{c.title}</h3>
          <p class="mt-3 text-gray-11">{c.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <div class="mx-auto grid max-w-page items-start gap-12 px-gutter pt-section lg:grid-cols-2 lg:gap-16">
    <section id="company" aria-labelledby="h-company">
      <h2 id="h-company" class="rise heading text-h2 text-gray-12">About {brand.name}</h2>
      <p class="mt-4 max-w-measure text-gray-11">{brand.legalName} is an independent software company. We build and run our own products and support every customer directly.</p>
      <dl class="mt-8 grid gap-4">
        {[
          ["Legal name", brand.legalName],
          ["Incorporated", `${brand.incorporated.display}, ${brand.incorporated.jurisdiction}`],
          ["Office", `${brand.address.street}, ${brand.address.city}, ${brand.address.region} ${brand.address.postal}`],
        ].map(([k, v]) => (
          <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
            <dt class="label text-gray-11">{k}</dt>
            <dd class="font-semibold text-gray-12">{k === "Incorporated" ? <><time datetime={brand.incorporated.iso}>{brand.incorporated.display}</time>, {brand.incorporated.jurisdiction}</> : v}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section id="contact" aria-labelledby="h-contact" class="rise rounded-card bg-harbour p-8 text-on-harbour sm:p-10">
      <h2 id="h-contact" class="heading text-h2">Let’s talk.</h2>
      <p class="mt-4 max-w-measure">Questions about a product, a partnership or a pilot for your business? Write or call. We usually reply the same business day.</p>
      <dl class="mt-6 grid gap-4">
        {[
          ["Email", <a href={`mailto:${brand.email}`} class="text-on-harbour no-underline hover:underline">{brand.email}</a>],
          ["Phone", <a href={`tel:${brand.phone.tel}`} class="text-on-harbour no-underline hover:underline">{brand.phone.display}</a>],
          ["Location", `${brand.address.city}, ${brand.address.regionName}`],
        ].map(([k, v]) => (
          <div class="grid gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="label text-on-harbour-2">{k}</dt>
            <dd class="font-semibold">{v}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={`mailto:${brand.email}`} variant="light">Email us</Button>
        <Button href={`tel:${brand.phone.tel}`} variant="ghost">Call</Button>
      </div>
    </section>
  </div>
</Base>
