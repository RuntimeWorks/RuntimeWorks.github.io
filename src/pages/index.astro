---
// Home. Macrostructure: a short statement, then the products split by who they are for (1Password's
// "business / personal" split and Duolingo's product row, read on Mobbin 2026-11-07), then the company and contact.
import Base from "../layouts/Base.astro"
import ProductCard from "../components/ProductCard.astro"
import Button from "../components/Button.astro"
import { brand, products, groups } from "../data/brand"

const business = products.filter((p) => p.group === "business")
const consumer = products.filter((p) => p.group === "consumer")
const words = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
const count = (n: number, one: string, many: string) => `${words[n] ?? n} ${n === 1 ? one : many}`

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${brand.url}/#organization`,
  name: brand.legalName,
  legalName: brand.legalName,
  url: `${brand.url}/`,
  logo: `${brand.url}/favicon.svg`,
  email: brand.email,
  telephone: brand.phone.tel,
  foundingDate: brand.incorporated.iso,
  address: { "@type": "PostalAddress", streetAddress: brand.address.street, addressLocality: brand.address.city, addressRegion: brand.address.region, postalCode: brand.address.postal, addressCountry: brand.address.country },
  makesOffer: products.map((p) => ({
    "@type": "Offer",
    itemOffered: { "@type": "SoftwareApplication", name: p.name, url: new URL(p.href, brand.url).href, applicationCategory: p.group === "business" ? "BusinessApplication" : "LifestyleApplication", description: p.summary },
  })),
}

const commitments = [
  { title: "One product, one job", text: "Each product solves one problem for one kind of user." },
  { title: "You reach the people who build it", text: "Every message and call is answered by the team that makes the product." },
  { title: "Your data stays yours", text: "We collect only what a product needs, and every product has its own privacy policy." },
]
---
<Base
  title={`${brand.legalName}: software for businesses and everyday life`}
  description={`${brand.legalName} makes software for small businesses and apps for people: Sheets Converter, PurchaseRow, the Food Safety and Dental Logbooks, and a meal planner. Charlottetown, Prince Edward Island.`}
  jsonLd={jsonLd}
>
  <section aria-labelledby="h-hero">
    <div class="mx-auto max-w-page px-gutter pt-section pb-8">
      <h1 id="h-hero" class="max-w-[18ch] text-4xl font-semibold tracking-tight text-gray-12">Software for businesses and for everyday life.</h1>
      <p class="mt-6 max-w-measure text-lg text-gray-11">
        {brand.legalName} makes {count(business.length, "product", "products")} for businesses and {count(consumer.length, "app", "apps")} for people, from Charlottetown, Prince Edward Island.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#products">See the products</Button>
        <Button href="#contact" variant="secondary">Contact us</Button>
      </div>
    </div>
  </section>

  <section id="products" aria-labelledby="h-products" class="mx-auto max-w-page px-gutter pt-section">
    <h2 id="h-products" class="text-3xl font-semibold tracking-tight text-gray-12">Products</h2>

    <section aria-labelledby="h-business" class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-gray-a6 pt-6">
        <h3 id="h-business" class="text-xl font-semibold text-gray-12">{groups.business.title}</h3>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {business.map((p) => <ProductCard product={p} />)}
      </div>
    </section>

    <section aria-labelledby="h-consumer" class="mt-section">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-gray-a6 pt-6">
        <h3 id="h-consumer" class="text-xl font-semibold text-gray-12">{groups.consumer.title}</h3>
      </div>
      <div class="mt-6 grid gap-6">
        {consumer.map((p) => <ProductCard product={p} wide />)}
      </div>
    </section>
  </section>

  <section id="company" aria-labelledby="h-company" class="mx-auto max-w-page px-gutter pt-section">
    <div class="grid gap-12 border-t border-gray-a6 pt-10 lg:grid-cols-2">
      <div>
        <h2 id="h-company" class="text-3xl font-semibold tracking-tight text-gray-12">Company</h2>
        <p class="mt-4 max-w-measure text-gray-11">{brand.legalName} is an independent software company. We build and run our own products and support every customer directly.</p>
        <dl class="mt-8 grid grid-cols-[minmax(8rem,auto)_1fr] border-t border-gray-a6 text-base">
          <dt class="border-b border-gray-a6 py-3 pr-4 text-gray-11">Legal name</dt><dd class="border-b border-gray-a6 py-3 font-medium">{brand.legalName}</dd>
          <dt class="border-b border-gray-a6 py-3 pr-4 text-gray-11">Incorporated</dt><dd class="border-b border-gray-a6 py-3 font-medium"><time datetime={brand.incorporated.iso}>{brand.incorporated.display}</time>, {brand.incorporated.jurisdiction}</dd>
          <dt class="border-b border-gray-a6 py-3 pr-4 text-gray-11">Office</dt><dd class="border-b border-gray-a6 py-3 font-medium">{brand.address.street}, {brand.address.city}, {brand.address.region} {brand.address.postal}</dd>
        </dl>
      </div>
      <ul class="grid content-start gap-6 lg:pt-14">
        {commitments.map((c) => (
          <li class="rounded-xl border border-gray-a6 bg-gray-1 p-6">
            <h3 class="text-lg font-semibold text-gray-12">{c.title}</h3>
            <p class="mt-2 text-gray-11">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" aria-labelledby="h-contact" class="mx-auto max-w-page px-gutter pt-section">
    <div class="rounded-2xl bg-accent-9 p-8 text-accent-contrast sm:p-12">
      <h2 id="h-contact" class="text-3xl font-semibold tracking-tight">Contact</h2>
      <p class="mt-3 max-w-measure">Questions about a product, a pilot or a partnership. We usually reply the same business day.</p>
      <dl class="mt-8 grid gap-x-10 gap-y-4 sm:grid-cols-3">
        <div><dt class="text-sm">Email</dt><dd class="mt-1 text-lg font-semibold"><a href={`mailto:${brand.email}`} class="underline decoration-1 underline-offset-4">{brand.email}</a></dd></div>
        <div><dt class="text-sm">Phone</dt><dd class="mt-1 text-lg font-semibold"><a href={`tel:${brand.phone.tel}`} class="underline decoration-1 underline-offset-4">{brand.phone.display}</a></dd></div>
        <div><dt class="text-sm">Office</dt><dd class="mt-1 text-lg font-semibold">{brand.address.city}, {brand.address.regionName}</dd></div>
      </dl>
    </div>
  </section>
</Base>
