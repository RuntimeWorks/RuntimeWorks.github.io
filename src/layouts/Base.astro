---
// The page shell every page uses: head metadata, skip link, header, main, footer.
import "../styles/global.css"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { brand } from "../data/brand"

interface Props {
  title: string
  description: string
  /** Leave out to use the page's own address. */
  canonical?: string
  image?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** A free tool page: printing shows only its sheets. */
  tool?: boolean
}
const { title, description, canonical, image = "/assets/og-company.png", noindex = false, jsonLd, tool = false } = Astro.props
const url = new URL(canonical ?? Astro.url.pathname, brand.url).href
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBF8F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The heading and text faces start loading with the page, so the first screen draws in them (web.dev, font best practices). -->
    <link rel="preload" href="/fonts/archivo-vf.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-vf.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, brand.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  </head>
  <body class="flex min-h-svh flex-col" data-tool={tool ? "" : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-accent-9 focus:px-4 focus:py-3 focus:text-accent-contrast">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
